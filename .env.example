# GenicUI — local environment overrides.
#
# Copy this file to `.env` (which is gitignored) and fill in the
# values for your machine. `bash start.sh` and `bash examples/playground/start.sh`
# both source `.env` automatically, exporting the variables into the
# server process so it can forward them to the spawned Claude Code
# subprocess.
#
# Required for the chat playground to talk to your LLM gateway:
#   ANTHROPIC_BASE_URL            — base URL of the OpenAI-compatible proxy
#   ANTHROPIC_AUTH_TOKEN          — bearer token the proxy expects
#   ANTHROPIC_MODEL               — primary model (opus equivalent)
#   ANTHROPIC_DEFAULT_OPUS_MODEL  — opus mapping
#   ANTHROPIC_DEFAULT_SONNET_MODEL — sonnet mapping
#   ANTHROPIC_DEFAULT_HAIKU_MODEL  — haiku mapping
#
# Optional / unused by current code but documented for parity with
# the Anthropic SDK naming:
#   ANTHROPIC_API_KEY (will OVERRIDE the oauth_token if set — usually leave unset)

ANTHROPIC_BASE_URL=http://ai.webreinvent.com:8080
ANTHROPIC_AUTH_TOKEN=local-vllm
ANTHROPIC_MODEL=qwen3.6-27b
ANTHROPIC_DEFAULT_OPUS_MODEL=qwen3.6-27b
ANTHROPIC_DEFAULT_SONNET_MODEL=qwen3.6-27b
ANTHROPIC_DEFAULT_HAIKU_MODEL=qwen3.6-27b
